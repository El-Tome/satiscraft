# Copy to .env.deploy (git-ignored) and fill in. Used by scripts/deploy-test.sh.
# One KEY=VALUE per line, read literally: no quotes or escaping needed, even for $ or #.

# SFTP account of the TEST server: panel > server > Settings > SFTP Details.
# Pterodactyl scopes it to that server only. The password is your panel password.
# From the server's own network, use the node's LAN address (the router may not loop back).
PTERODACTYL_SFTP=sftp://node.example.com:2022
PTERODACTYL_SFTP_USER=username.abcd1234
PTERODACTYL_SFTP_PASSWORD=changeme
# Optional: where the server keeps its mods.
# PTERODACTYL_MODS_DIR=/mods

# Optional: restart after upload, through the client API. Without a key, restart by hand.
# Key: panel > account (top right) > API Credentials, starts with ptlc_. A client key acts on
# every server of its account: create it from an account that only reaches the test server.
PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_SERVER_ID=abcd1234
# PTERODACTYL_API_KEY=ptlc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
